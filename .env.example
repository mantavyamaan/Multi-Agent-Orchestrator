--- Execution mode ---
# "mock"  = no API calls, deterministic PoC behavior (default)
# "live"  = real model calls
AGENT_MODE=mock

--- Live mode provider (LangChain init_chat_model format) ---
MODEL_NAME=gpt-4o-mini
MODEL_PROVIDER=openai
OPENAI_API_KEY=sk-...

--- Runtime safety limits (§5.11) ---
MAX_STEPS=12
MAX_ERRORS=3
MAX_CONSECUTIVE_REPEATS=3
RUN_TIMEOUT_SECONDS=180
